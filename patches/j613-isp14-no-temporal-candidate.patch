Local J613 ISP14.7 opt-in experiment; not an upstream support claim.
Base: omacom/linux-aurora 5ec1028c81526e1ed31db2b97e47edf8663e83cb
Original ISP driver copyright: Eileen Yoon and upstream contributors.
Hypothesis: scottjones, Aurora issue117 and PR119 (26.6.2 work).
This test scopes the skip to J613 + 14.7, without firmware/calibration changes.
https://github.com/omacom/linux-aurora/issues/117#issuecomment-6159609193
https://github.com/omacom/linux-aurora/pull/119

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 5090ed2..59066a0 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -2,6 +2,8 @@
 /* Copyright 2023 Eileen Yoon <eyn@gmx.com> */
 
 #include <linux/firmware.h>
+#include <linux/moduleparam.h>
+#include <linux/of.h>
 #include <linux/unaligned.h>
 
 #include "isp-cam.h"
@@ -10,6 +12,14 @@
 #include "isp-iommu.h"
 #include "isp-regs.h"
 
+/* Local 14.7 J613 experiment, suggested by Aurora #117/#119.
+ * Scoped separately from the 26.6.2 work; no firmware/version override.
+ */
+static bool j613_no_temporal;
+module_param(j613_no_temporal, bool, 0444);
+MODULE_PARM_DESC(j613_no_temporal,
+                "J613 ISP 14.7 only: skip MBNR/temporal/motion stages (default off)");
+
 #define ISP_MAX_PRESETS 32
 
 struct isp_setfile {
@@ -504,9 +514,17 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	if (err)
 		return err;
 
-	err = isp_cmd_ch_mbnr_enable(isp, ch, 0, ISP_MBNR_MODE_ENABLE, 1);
-	if (err)
-		return err;
+	bool temporal = !(j613_no_temporal &&
+                          isp->fw_compat == ISP_FIRMWARE_V_14_7 &&
+                          of_machine_is_compatible("apple,j613"));
+
+	if (!temporal)
+		dev_warn(isp->dev, "J613 14.7 experiment: temporal/MBNR/motion stages skipped\n");
+	if (temporal) {
+		err = isp_cmd_ch_mbnr_enable(isp, ch, 0, ISP_MBNR_MODE_ENABLE, 1);
+		if (err)
+			return err;
+	}
 
 	/* The H17 firmware faults on this face-detection metering setup. */
 	if (!h17) {
@@ -538,17 +556,19 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 			return err;
 	}
 
-	err = isp_cmd_apple_ch_temporal_filter_start(isp, ch, isp->temporal_filter);
-	if (err)
-		return err;
+	if (temporal) {
+		err = isp_cmd_apple_ch_temporal_filter_start(isp, ch, isp->temporal_filter);
+		if (err)
+			return err;
 
-	err = isp_cmd_apple_ch_motion_history_start(isp, ch);
-	if (err)
-		return err;
+		err = isp_cmd_apple_ch_motion_history_start(isp, ch);
+		if (err)
+			return err;
 
-	err = isp_cmd_apple_ch_temporal_filter_enable(isp, ch);
-	if (err)
-		return err;
+		err = isp_cmd_apple_ch_temporal_filter_enable(isp, ch);
+		if (err)
+			return err;
+	}
 
 	if (h17)
 		return isp_cmd_ch_master_slave_sync_mode_set(isp, ch, 0);
